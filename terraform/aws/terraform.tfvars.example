# Example values for terraform/aws.
# Copy to terraform.tfvars locally if needed. Do NOT commit terraform.tfvars.
# Do NOT put credentials, access keys, or session tokens in this file.

aws_region   = "ap-south-1"
project_name = "platform-lab"
environment  = "aws-lab"

vpc_cidr             = "10.50.0.0/16"
availability_zones   = ["ap-south-1a", "ap-south-1b"]
public_subnet_cidrs  = ["10.50.0.0/20", "10.50.16.0/20"]
private_subnet_cidrs = ["10.50.32.0/20", "10.50.48.0/20"]

kubernetes_version = "1.36"
node_instance_type = "t3.medium"
desired_node_count = 2
min_node_count     = 1
max_node_count     = 3
root_volume_size   = 20

enable_single_nat_gateway = true

cluster_endpoint_private_access = true
cluster_endpoint_public_access  = true
# REQUIRED: replace with your public IP/32 (or office CIDR). Never use 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

enable_cluster_logging = false

git_repo_url        = "https://github.com/kirandevraaj/kubernetes-platform-engineering-gitops.git"
git_target_revision = "main"

install_aws_load_balancer_controller = true
install_metrics_server               = true
install_argocd                       = true
bootstrap_gitops                     = true
install_ebs_csi_driver               = true
ebs_csi_addon_version                = "v1.66.0-eksbuild.1"
